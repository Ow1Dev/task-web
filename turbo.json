{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate-openapi": {
      "cache": false,
      "outputs": ["packages/task-sdk/openapi.json"]
    },
    "generate": {
      "dependsOn": ["^generate-openapi"],
      "inputs": ["openapi.json"],
      "outputs": ["src/lib/**"]
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "outputs": ["dist/**"]
    }
  }
}
