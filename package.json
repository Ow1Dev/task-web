{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker-compose up -d && turbo run dev",
    "lint": "turbo run lint",
    "migrate": "cargo run --bin migration",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate": "openapi-generator-cli generate -i ./docs/openapi.json -g typescript-fetch -o ./packages/client-sdk --additional-properties=npmName=@task-web/client-sdk,npmVersion=1.0.0,supportsES6=true --skip-validate-spec"
  },
  "devDependencies": {
    "@angular/cli": "^21.1.4",
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2",
    "@openapitools/openapi-generator-cli": "^2.30.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
